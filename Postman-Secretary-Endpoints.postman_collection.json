{
  "info": {
    "name": "MediCare – Secretary Endpoints",
    "_postman_id": "sec-collection-001",
    "description": "All API endpoints available to a SECRETARY role. Login uses MFA on new/untrusted devices; trusted devices skip MFA. First-time staff must complete activation after MFA.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "mfaToken", "value": "", "type": "string" },
    { "key": "activationToken", "value": "", "type": "string" },
    { "key": "deviceId", "value": "postman-secretary-device-001", "type": "string" },
    { "key": "clinicId", "value": "", "type": "string" },
    { "key": "doctorId", "value": "", "type": "string" },
    { "key": "patientId", "value": "", "type": "string" },
    { "key": "appointmentId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Step 1)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+9647XXXXXXXXX\",\n  \"password\": \"YourPassword123!\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            },
            "description": "Login with phone + password. New/untrusted device: returns requiresMfa + mfaToken. Trusted device: returns accessToken directly. First-time staff also get requiresPasswordChange after MFA."
          }
        },
        {
          "name": "Verify MFA OTP (Step 2)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/verify-mfa", "host": ["{{baseUrl}}"], "path": ["api", "auth", "verify-mfa"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfaToken\": \"{{mfaToken}}\",\n  \"otp\": \"123456\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            },
            "description": "Verify MFA OTP. Active secretary: returns accessToken. First login (PENDING_ACTIVATION): returns activationToken — proceed to Complete Staff Activation."
          }
        },
        {
          "name": "Resend MFA OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/resend-mfa-otp", "host": ["{{baseUrl}}"], "path": ["api", "auth", "resend-mfa-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfaToken\": \"{{mfaToken}}\"\n}"
            },
            "description": "Resend MFA OTP using a pending mfaToken."
          }
        },
        {
          "name": "Complete Staff Activation (Step 3 - first login only)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/staff/complete-activation", "host": ["{{baseUrl}}"], "path": ["api", "auth", "staff", "complete-activation"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activationToken\": \"{{activationToken}}\",\n  \"newPassword\": \"NewSecurePass123!\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            },
            "description": "First-time staff only. Set permanent password after MFA. Returns accessToken + refreshToken and trusts this device."
          }
        },
        {
          "name": "Send Password Reset OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/forgot-password/send-otp", "host": ["{{baseUrl}}"], "path": ["api", "auth", "forgot-password", "send-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+9647XXXXXXXXX\"\n}"
            },
            "description": "Send password reset OTP via WhatsApp. Dev mode may return devOtp in response."
          }
        },
        {
          "name": "Reset Password (OTP)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "reset-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+9647XXXXXXXXX\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewSecurePass123!\"\n}"
            },
            "description": "Complete password reset with OTP from forgot-password/send-otp."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh-token"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"your-refresh-token-here\"\n}"
            },
            "description": "Exchange a refresh token for a new access + refresh token pair."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"optional-session-id\"\n}"
            },
            "description": "Logout the current session."
          }
        },
        {
          "name": "Get Active Sessions",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/sessions", "host": ["{{baseUrl}}"], "path": ["api", "auth", "sessions"] },
            "description": "List all active sessions for the currently authenticated secretary."
          }
        },
        {
          "name": "Revoke Session by ID",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/auth/sessions/:sessionId", "host": ["{{baseUrl}}"], "path": ["api", "auth", "sessions", ":sessionId"], "variable": [{ "key": "sessionId", "value": "" }] },
            "description": "Revoke a specific session by its ID."
          }
        },
        {
          "name": "Revoke All Sessions",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/auth/sessions?except=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sessions"],
              "query": [{ "key": "except", "value": "", "description": "Session ID to keep alive (optional)" }]
            },
            "description": "Revoke all sessions without except param also revokes all trusted devices — MFA required on next login."
          }
        }
      ]
    },
    {
      "name": "My Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "description": "Get own user profile."
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Name\",\n  \"email\": \"secretary@clinic.com\"\n}"
            },
            "description": "Update own profile fields."
          }
        },
        {
          "name": "Change My Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}/change-password", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}", "change-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"OldPass123!\",\n  \"newPassword\": \"NewPass456!\"\n}"
            },
            "description": "Change own password."
          }
        }
      ]
    },
    {
      "name": "Clinics",
      "item": [
        {
          "name": "Get My Clinics",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clinics/me", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "me"] },
            "description": "List all clinics the secretary is assigned to."
          }
        },
        {
          "name": "Get Clinic by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clinics/{{clinicId}}", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "{{clinicId}}"] },
            "description": "Get basic clinic info by ID."
          }
        },
        {
          "name": "Get Clinic Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clinics/{{clinicId}}/profile", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "{{clinicId}}", "profile"] },
            "description": "Get detailed clinic profile including staff counts and schedule info."
          }
        },
        {
          "name": "Get Clinic Staff",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/clinics/{{clinicId}}/staff?staffRole=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clinics", "{{clinicId}}", "staff"],
              "query": [{ "key": "staffRole", "value": "", "description": "Filter by role: DOCTOR, SECRETARY" }]
            },
            "description": "List staff members assigned to a clinic."
          }
        },
        {
          "name": "Get Clinic Doctors",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clinics/{{clinicId}}/doctors", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "{{clinicId}}", "doctors"] },
            "description": "List all doctors at a clinic."
          }
        },
        {
          "name": "Search Clinics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/clinics/search?q=&city=&governorate=&specialization=&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clinics", "search"],
              "query": [
                { "key": "q", "value": "", "description": "Search query" },
                { "key": "city", "value": "" },
                { "key": "governorate", "value": "" },
                { "key": "specialization", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Full-text and filtered search for clinics."
          }
        }
      ]
    },
    {
      "name": "Schedule",
      "item": [
        {
          "name": "Get Available Slots",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/schedule/slots?clinicId={{clinicId}}&doctorId={{doctorId}}&date=2026-06-20&durationMinutes=30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schedule", "slots"],
              "query": [
                { "key": "clinicId", "value": "{{clinicId}}" },
                { "key": "doctorId", "value": "{{doctorId}}" },
                { "key": "date", "value": "2026-06-20", "description": "Format: YYYY-MM-DD" },
                { "key": "durationMinutes", "value": "30" }
              ]
            },
            "description": "Returns all available appointment time slots for a doctor at a clinic on a given date."
          }
        },
        {
          "name": "Get Doctor Availability",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/schedule/availability?clinicId={{clinicId}}&doctorId={{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schedule", "availability"],
              "query": [
                { "key": "clinicId", "value": "{{clinicId}}" },
                { "key": "doctorId", "value": "{{doctorId}}", "description": "Optional" }
              ]
            },
            "description": "List doctor availability windows (recurring weekly schedule) for a clinic."
          }
        },
        {
          "name": "Create Availability Window",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/schedule/availability", "host": ["{{baseUrl}}"], "path": ["api", "schedule", "availability"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicId\": \"{{clinicId}}\",\n  \"doctorId\": \"{{doctorId}}\",\n  \"dayOfWeek\": 1,\n  \"startTime\": \"09:00\",\n  \"endTime\": \"13:00\",\n  \"slotDurationMinutes\": 30\n}"
            },
            "description": "Create a recurring availability window for a doctor (e.g., Mon 09:00–13:00). dayOfWeek: 0=Sunday, 1=Monday … 6=Saturday."
          }
        },
        {
          "name": "Block Time Period",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/schedule/blocked", "host": ["{{baseUrl}}"], "path": ["api", "schedule", "blocked"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicId\": \"{{clinicId}}\",\n  \"doctorId\": \"{{doctorId}}\",\n  \"startsAt\": \"2026-06-25T08:00:00.000Z\",\n  \"endsAt\": \"2026-06-25T12:00:00.000Z\",\n  \"reason\": \"Doctor vacation\"\n}"
            },
            "description": "Block out a period of time for a doctor or the whole clinic."
          }
        },
        {
          "name": "Get Clinic Hours",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/schedule/clinics/{{clinicId}}/hours", "host": ["{{baseUrl}}"], "path": ["api", "schedule", "clinics", "{{clinicId}}", "hours"] },
            "description": "Get a clinic's weekly operating hours (all 7 days)."
          }
        },
        {
          "name": "Update Clinic Hours",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/schedule/clinics/{{clinicId}}/hours", "host": ["{{baseUrl}}"], "path": ["api", "schedule", "clinics", "{{clinicId}}", "hours"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayOfWeek\": 0,\n  \"openTime\": \"08:00\",\n  \"closeTime\": \"17:00\",\n  \"isClosed\": false\n}"
            },
            "description": "Set or update a clinic's hours for a specific day. dayOfWeek: 0=Sunday … 6=Saturday."
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "List Clinic Appointments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/appointments?clinicId={{clinicId}}&doctorId=&patientId=&status=&from=&to=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments"],
              "query": [
                { "key": "clinicId", "value": "{{clinicId}}", "description": "Required" },
                { "key": "doctorId", "value": "", "description": "Optional filter" },
                { "key": "patientId", "value": "", "description": "Optional filter" },
                { "key": "status", "value": "", "description": "PENDING | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW" },
                { "key": "from", "value": "", "description": "ISO date, e.g. 2026-06-01" },
                { "key": "to", "value": "", "description": "ISO date, e.g. 2026-06-30" }
              ]
            },
            "description": "List clinic appointments with filtering. Used by the secretary dashboard."
          }
        },
        {
          "name": "Get Appointment by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "{{appointmentId}}"] },
            "description": "Get a single appointment's full details enriched with clinic/doctor/patient info."
          }
        },
        {
          "name": "Create Appointment (on behalf of patient)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/appointments", "host": ["{{baseUrl}}"], "path": ["api", "appointments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicId\": \"{{clinicId}}\",\n  \"doctorId\": \"{{doctorId}}\",\n  \"patientId\": \"{{patientId}}\",\n  \"scheduledAt\": \"2026-06-20T10:00:00.000Z\",\n  \"durationMinutes\": 30,\n  \"reason\": \"Regular checkup\"\n}"
            },
            "description": "Book an appointment on behalf of a patient. patientId is required when booked by staff."
          }
        },
        {
          "name": "Update Appointment",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "{{appointmentId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduledAt\": \"2026-06-21T11:00:00.000Z\",\n  \"durationMinutes\": 30,\n  \"reason\": \"Follow-up\",\n  \"notes\": \"Patient requested morning slot\"\n}"
            },
            "description": "Reschedule or update appointment details."
          }
        },
        {
          "name": "Update Appointment Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "{{appointmentId}}", "status"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\",\n  \"cancellationReason\": \"\"\n}"
            },
            "description": "Change appointment status. Values: PENDING | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW."
          }
        }
      ]
    },
    {
      "name": "Patient Lookup",
      "item": [
        {
          "name": "Lookup Patient by Phone",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/lookup/patient/:phoneNumber", "host": ["{{baseUrl}}"], "path": ["api", "users", "lookup", "patient", ":phoneNumber"], "variable": [{ "key": "phoneNumber", "value": "+9647XXXXXXXXX" }] },
            "description": "Look up a patient account by phone number. Returns basic profile; fails if account is not PATIENT role."
          }
        },
        {
          "name": "Get Patient Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/{{patientId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{patientId}}"] },
            "description": "Get full patient profile by user ID."
          }
        }
      ]
    },
    {
      "name": "Doctor Profiles",
      "item": [
        {
          "name": "Get Doctor Public Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/doctors/{{doctorId}}/public", "host": ["{{baseUrl}}"], "path": ["api", "users", "doctors", "{{doctorId}}", "public"] },
            "description": "Get one doctor's public profile."
          }
        },
        {
          "name": "Get Multiple Doctors Public Profiles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users/doctors/public?ids=id1,id2,id3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "doctors", "public"],
              "query": [{ "key": "ids", "value": "id1,id2,id3", "description": "Comma-separated UUIDs, max 50" }]
            },
            "description": "Batch-fetch public doctor profiles by IDs."
          }
        }
      ]
    }
  ]
}
