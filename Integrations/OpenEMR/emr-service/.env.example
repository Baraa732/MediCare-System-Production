PORT=3004
NODE_ENV=development

DATABASE_HOST=postgres-emr
DATABASE_PORT=5432
DATABASE_USER=clinic_user
DATABASE_PASSWORD=
DATABASE_NAME=emr_db

KAFKA_BROKERS=kafka-1:9092
KAFKA_RETRY_COUNT=12
KAFKA_CONNECTION_TIMEOUT=15000

INTERNAL_SERVICE_TOKEN=
JWT_SECRET=

OPENEMR_BASE_URL=https://openemr
OPENEMR_SITE=default
OPENEMR_ADMIN_USER=admin
OPENEMR_ADMIN_PASSWORD=
# Optional — if set, skips auto-registration on first boot
OPENEMR_CLIENT_ID=
OPENEMR_CLIENT_SECRET=

OPENEMR_MYSQL_HOST=mariadb-openemr
OPENEMR_MYSQL_USER=openemr
OPENEMR_MYSQL_PASSWORD=
OPENEMR_MYSQL_DATABASE=openemr

ALLOWED_ORIGINS=http://localhost:3000
