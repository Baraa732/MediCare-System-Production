  <diagram id="oauth" name="2 - OAuth2 Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t2" value="OAuth2 — How emr-service accesses OpenEMR FHIR" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="600" height="40" as="geometry" />
        </mxCell>

        <mxCell id="oc" value="OpenEmrClient&#xa;(emr-service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="oauth" value="OpenEMR OAuth2&#xa;/oauth2/default/token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="fhir" value="OpenEMR FHIR API&#xa;/fhir/Patient, /fhir/Observation..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="680" y="120" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cache" value="Token cache&#xa;(in-memory, ~1 hour)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="step1" value="1. One-time: register OAuth client&#xa;→ client_id + client_secret" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="320" height="50" as="geometry" />
        </mxCell>

        <mxCell id="step2" value="2. POST /token (password grant)&#xa;client_id, client_secret, admin user, scopes" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="80" y="410" width="320" height="50" as="geometry" />
        </mxCell>

        <mxCell id="step3" value="3. GET /fhir/* with Authorization: Bearer {token}" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="80" y="480" width="320" height="50" as="geometry" />
        </mxCell>

        <mxCell id="o1" value="getAccessToken()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="oc" target="oauth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="access_token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="oauth" target="oc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="220" />
              <mxPoint x="160" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="o3" value="Bearer token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#0066CC;" edge="1" parent="1" source="oc" target="fhir">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="oc" target="cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o5" value="FHIR JSON response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="fhir" target="oc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="790" y="220" />
              <mxPoint x="160" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="note" value="OAuth2 = temporary access pass&#xa;MediCare never sends patient passwords to OpenEMR on every chart request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="480" y="340" width="420" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

