{
  "info": {
    "name": "MediCare AI API",
    "description": "Ollama-powered AI endpoints for MediCare clinic platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "AI Status",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/ai/status"
      }
    },
    {
      "name": "Generate Summary",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Patient visited for routine checkup. BP 120/80. Continue current medication.\"\n}"
        },
        "url": "{{baseUrl}}/api/ai/summary"
      }
    },
    {
      "name": "Generate Medical Report",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientInfo\": \"John Doe, 45M, hypertension\",\n  \"labResults\": \"HbA1c 6.2%, LDL 110\",\n  \"doctorNotes\": \"Stable on current regimen\",\n  \"diagnoses\": \"Essential hypertension\"\n}"
        },
        "url": "{{baseUrl}}/api/ai/report"
      }
    },
    {
      "name": "OCR Cleanup (raw text)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rawText\": \"HbA1c: 6.2%0 Date: 2025-01-15\",\n  \"documentType\": \"lab_report\"\n}"
        },
        "url": "{{baseUrl}}/api/ai/ocr-cleanup"
      }
    },
    {
      "name": "OCR Cleanup (image base64)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"imageBase64\": \"<base64-from-camera>\",\n  \"documentType\": \"prescription\"\n}"
        },
        "url": "{{baseUrl}}/api/ai/ocr-cleanup"
      }
    },
    {
      "name": "Patient Chat",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"How should I prepare for my blood test?\",\n  \"context\": \"Appointment scheduled for Monday 9 AM\"\n}"
        },
        "url": "{{baseUrl}}/api/ai/patient-chat"
      }
    },
    {
      "name": "Doctor Chat",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"Summarize this patient's recent visit history\",\n  \"patientContext\": \"3 visits in last 6 months for hypertension management\"\n}"
        },
        "url": "{{baseUrl}}/api/ai/doctor-chat"
      }
    },
    {
      "name": "Appointment Note",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"Pt c/o headache x2d. BP 130/85. Advised hydration. F/U 1wk.\",\n  \"context\": \"Follow-up visit\"\n}"
        },
        "url": "{{baseUrl}}/api/ai/appointment-note"
      }
    },
    {
      "name": "Clinical Assessment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"data\": \"45M, BP 130/85, on lisinopril 10mg, no chest pain\"\n}"
        },
        "url": "{{baseUrl}}/api/ai/clinical-assessment"
      }
    },
    {
      "name": "Recommendations",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"data\": \"Hypertension, suboptimal control, no secondary symptoms\"\n}"
        },
        "url": "{{baseUrl}}/api/ai/recommendations"
      }
    },
    {
      "name": "AI Metrics (Platform Admin)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/ai/metrics"
      }
    }
  ]
}
