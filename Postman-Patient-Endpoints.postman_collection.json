{
  "info": {
    "name": "MediCare – Patient Endpoints",
    "_postman_id": "pat-collection-001",
    "description": "All API endpoints available to a PATIENT role. Login uses MFA on new/untrusted devices; trusted devices skip MFA.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "mfaToken", "value": "", "type": "string" },
    { "key": "deviceId", "value": "postman-patient-device-001", "type": "string" },
    { "key": "clinicId", "value": "", "type": "string" },
    { "key": "doctorId", "value": "", "type": "string" },
    { "key": "appointmentId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}", "description": "Required UUID for register. Postman auto-generates each send." }
            ],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+9647XXXXXXXXX\",\n  \"firstName\": \"Ahmed\",\n  \"lastName\": \"Hassan\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"PATIENT\",\n  \"email\": \"patient@email.com\"\n}"
            },
            "description": "Register a new patient account. Initiates phone OTP verification after registration."
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/send-otp", "host": ["{{baseUrl}}"], "path": ["api", "auth", "send-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+9647XXXXXXXXX\"\n}"
            },
            "description": "Send a 6-digit OTP to the phone number for verification."
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["api", "auth", "verify-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+9647XXXXXXXXX\",\n  \"otp\": \"123456\",\n  \"autoLogin\": \"true\"\n}"
            },
            "description": "Verify OTP sent to phone. Set autoLogin to true to receive tokens immediately after verification."
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/resend-otp", "host": ["{{baseUrl}}"], "path": ["api", "auth", "resend-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+9647XXXXXXXXX\"\n}"
            },
            "description": "Resend OTP to a phone number."
          }
        },
        {
          "name": "Check OTP Status",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/check-otp-status", "host": ["{{baseUrl}}"], "path": ["api", "auth", "check-otp-status"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+9647XXXXXXXXX\"\n}"
            },
            "description": "Check if an active OTP exists for a phone number (for polling)."
          }
        },
        {
          "name": "Login (Step 1)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+9647XXXXXXXXX\",\n  \"password\": \"SecurePass123!\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            },
            "description": "Login with phone + password. New/untrusted device: returns requiresMfa + mfaToken. Trusted device: returns accessToken directly."
          }
        },
        {
          "name": "Verify MFA OTP (Step 2)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/verify-mfa", "host": ["{{baseUrl}}"], "path": ["api", "auth", "verify-mfa"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfaToken\": \"{{mfaToken}}\",\n  \"otp\": \"123456\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            },
            "description": "Verify MFA OTP after login. Returns accessToken + refreshToken and trusts this device for future logins."
          }
        },
        {
          "name": "Resend MFA OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/resend-mfa-otp", "host": ["{{baseUrl}}"], "path": ["api", "auth", "resend-mfa-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfaToken\": \"{{mfaToken}}\"\n}"
            },
            "description": "Resend MFA OTP using a pending mfaToken."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "reset-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+9647XXXXXXXXX\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPass789!\"\n}"
            },
            "description": "Reset password using OTP verification. First send an OTP, then call this with the received OTP."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh-token"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"your-refresh-token-here\"\n}"
            },
            "description": "Exchange a refresh token for a new access + refresh token pair."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"optional-session-id\"\n}"
            },
            "description": "Logout the current session. Optionally pass sessionId to target a specific session."
          }
        },
        {
          "name": "Get Active Sessions",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/sessions", "host": ["{{baseUrl}}"], "path": ["api", "auth", "sessions"] },
            "description": "List all active sessions for the currently authenticated patient."
          }
        },
        {
          "name": "Revoke Session by ID",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/auth/sessions/:sessionId", "host": ["{{baseUrl}}"], "path": ["api", "auth", "sessions", ":sessionId"], "variable": [{ "key": "sessionId", "value": "" }] },
            "description": "Revoke a specific session by its ID."
          }
        },
        {
          "name": "Revoke All Sessions",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/auth/sessions?except=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sessions"],
              "query": [{ "key": "except", "value": "", "description": "Session ID to keep alive (optional)" }]
            },
            "description": "Revoke all sessions without except param also revokes all trusted devices — MFA required on next login."
          }
        }
      ]
    },
    {
      "name": "My Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "description": "Get own patient profile (includes sensitive fields when requesting own profile)."
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ahmed\",\n  \"lastName\": \"Hassan\",\n  \"email\": \"patient@email.com\"\n}"
            },
            "description": "Update own profile fields."
          }
        },
        {
          "name": "Change My Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}/change-password", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}", "change-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"OldPass123!\",\n  \"newPassword\": \"NewPass456!\"\n}"
            },
            "description": "Change own password."
          }
        }
      ]
    },
    {
      "name": "Discover",
      "item": [
        {
          "name": "Search Clinics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/clinics/search?q=&city=&governorate=&specialization=&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clinics", "search"],
              "query": [
                { "key": "q", "value": "", "description": "Search query" },
                { "key": "city", "value": "" },
                { "key": "governorate", "value": "" },
                { "key": "specialization", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Search for clinics by name, city, governorate, or specialization."
          }
        },
        {
          "name": "Get Clinic by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clinics/{{clinicId}}", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "{{clinicId}}"] },
            "description": "Get basic clinic info by ID."
          }
        },
        {
          "name": "Get Clinic Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clinics/{{clinicId}}/profile", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "{{clinicId}}", "profile"] },
            "description": "Get detailed clinic profile including staff counts and schedule info."
          }
        },
        {
          "name": "Get Clinic Doctors",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clinics/{{clinicId}}/doctors", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "{{clinicId}}", "doctors"] },
            "description": "List all doctors at a clinic."
          }
        },
        {
          "name": "Get Doctor Public Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/doctors/{{doctorId}}/public", "host": ["{{baseUrl}}"], "path": ["api", "users", "doctors", "{{doctorId}}", "public"] },
            "description": "Get a doctor's public profile (name, specialization, etc.)."
          }
        },
        {
          "name": "Get Multiple Doctors Public Profiles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users/doctors/public?ids=id1,id2,id3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "doctors", "public"],
              "query": [{ "key": "ids", "value": "id1,id2,id3", "description": "Comma-separated UUIDs, max 50" }]
            },
            "description": "Batch-fetch public doctor profiles by IDs."
          }
        }
      ]
    },
    {
      "name": "Scheduling",
      "item": [
        {
          "name": "Get Available Slots",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/schedule/slots?clinicId={{clinicId}}&doctorId={{doctorId}}&date=2026-06-20&durationMinutes=30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schedule", "slots"],
              "query": [
                { "key": "clinicId", "value": "{{clinicId}}" },
                { "key": "doctorId", "value": "{{doctorId}}" },
                { "key": "date", "value": "2026-06-20", "description": "Format: YYYY-MM-DD" },
                { "key": "durationMinutes", "value": "30" }
              ]
            },
            "description": "Returns all available appointment time slots for a doctor at a clinic on a given date."
          }
        },
        {
          "name": "Get Doctor Availability",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/schedule/availability?clinicId={{clinicId}}&doctorId={{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schedule", "availability"],
              "query": [
                { "key": "clinicId", "value": "{{clinicId}}" },
                { "key": "doctorId", "value": "{{doctorId}}", "description": "Optional" }
              ]
            },
            "description": "List doctor recurring weekly availability windows."
          }
        },
        {
          "name": "Get Clinic Hours",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/schedule/clinics/{{clinicId}}/hours", "host": ["{{baseUrl}}"], "path": ["api", "schedule", "clinics", "{{clinicId}}", "hours"] },
            "description": "Get the clinic's weekly operating hours."
          }
        }
      ]
    },
    {
      "name": "My Appointments",
      "item": [
        {
          "name": "Book Appointment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/appointments", "host": ["{{baseUrl}}"], "path": ["api", "appointments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicId\": \"{{clinicId}}\",\n  \"doctorId\": \"{{doctorId}}\",\n  \"scheduledAt\": \"2026-06-20T10:00:00.000Z\",\n  \"durationMinutes\": 30,\n  \"reason\": \"Regular checkup\"\n}"
            },
            "description": "Book an appointment for yourself. patientId is NOT required — it is automatically set to the authenticated patient."
          }
        },
        {
          "name": "Get My Appointments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/appointments/me?status=&group=upcoming",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "me"],
              "query": [
                { "key": "status", "value": "", "description": "PENDING | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW" },
                { "key": "group", "value": "upcoming", "description": "all | upcoming | completed | cancelled | past" }
              ]
            },
            "description": "Get own appointment history with optional filtering by status or group."
          }
        },
        {
          "name": "Get Appointment by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "{{appointmentId}}"] },
            "description": "Get full details of a specific appointment."
          }
        },
        {
          "name": "Update Appointment",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "{{appointmentId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduledAt\": \"2026-06-21T11:00:00.000Z\",\n  \"reason\": \"Updated reason for visit\"\n}"
            },
            "description": "Reschedule or update appointment reason."
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "{{appointmentId}}", "status"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CANCELLED\",\n  \"cancellationReason\": \"Personal reasons\"\n}"
            },
            "description": "Cancel an appointment. Allowed statuses: PENDING | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW."
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get My Notifications",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/notifications/me?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "me"],
              "query": [
                { "key": "page", "value": "1", "description": "Default 1" },
                { "key": "limit", "value": "20", "description": "Default 20, max 50" }
              ]
            },
            "description": "Get the patient's paginated notification history (appointment reminders, etc.)."
          }
        }
      ]
    }
  ]
}
