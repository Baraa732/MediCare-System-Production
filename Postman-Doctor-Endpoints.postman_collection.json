{
  "info": {
    "name": "MediCare – Doctor Endpoints",
    "_postman_id": "doc-collection-001",
    "description": "All API endpoints available to a DOCTOR role in the MediCare clinic management system.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "mfaToken", "value": "", "type": "string" },
    { "key": "clinicId", "value": "", "type": "string" },
    { "key": "doctorId", "value": "", "type": "string" },
    { "key": "patientId", "value": "", "type": "string" },
    { "key": "appointmentId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Step 1)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+9647XXXXXXXXX\",\n  \"password\": \"YourPassword123!\"\n}"
            },
            "description": "Login with phone + password. If MFA is required (doctors), you'll receive { requiresMfa: true, mfaToken }. Save the mfaToken and proceed to Verify MFA."
          }
        },
        {
          "name": "Verify MFA OTP (Step 2)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/verify-mfa", "host": ["{{baseUrl}}"], "path": ["api", "auth", "verify-mfa"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfaToken\": \"{{mfaToken}}\",\n  \"otp\": \"123456\"\n}"
            },
            "description": "Complete MFA login for doctors. Returns full JWT tokens on success."
          }
        },
        {
          "name": "Resend MFA OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/resend-mfa-otp", "host": ["{{baseUrl}}"], "path": ["api", "auth", "resend-mfa-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfaToken\": \"{{mfaToken}}\"\n}"
            },
            "description": "Resend MFA OTP using a pending mfaToken."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh-token"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"your-refresh-token-here\"\n}"
            },
            "description": "Exchange a refresh token for a new access + refresh token pair."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"optional-session-id\"\n}"
            },
            "description": "Logout the current session."
          }
        },
        {
          "name": "Get Active Sessions",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/sessions", "host": ["{{baseUrl}}"], "path": ["api", "auth", "sessions"] },
            "description": "List all active sessions for the currently authenticated doctor."
          }
        },
        {
          "name": "Revoke Session by ID",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/auth/sessions/:sessionId", "host": ["{{baseUrl}}"], "path": ["api", "auth", "sessions", ":sessionId"], "variable": [{ "key": "sessionId", "value": "" }] },
            "description": "Revoke a specific session by its ID."
          }
        },
        {
          "name": "Revoke All Sessions",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/auth/sessions?except=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sessions"],
              "query": [{ "key": "except", "value": "", "description": "Session ID to keep alive (optional)" }]
            },
            "description": "Revoke all sessions, optionally keeping the current one."
          }
        },
        {
          "name": "Complete Staff Activation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/staff/complete-activation", "host": ["{{baseUrl}}"], "path": ["api", "auth", "staff", "complete-activation"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activationToken\": \"token-sent-via-whatsapp\",\n  \"newPassword\": \"NewSecurePass123!\"\n}"
            },
            "description": "Set permanent password using the activation token received via WhatsApp."
          }
        }
      ]
    },
    {
      "name": "My Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "description": "Get own user profile."
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Name\",\n  \"email\": \"doctor@clinic.com\",\n  \"specialization\": \"Cardiology\"\n}"
            },
            "description": "Update own profile fields including specialization."
          }
        },
        {
          "name": "Change My Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}/change-password", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}", "change-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"OldPass123!\",\n  \"newPassword\": \"NewPass456!\"\n}"
            },
            "description": "Change own password."
          }
        },
        {
          "name": "Get My Public Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/doctors/{{doctorId}}/public", "host": ["{{baseUrl}}"], "path": ["api", "users", "doctors", "{{doctorId}}", "public"] },
            "description": "Get own public doctor profile (what patients/staff see)."
          }
        }
      ]
    },
    {
      "name": "Clinics",
      "item": [
        {
          "name": "Get My Clinics",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clinics/me", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "me"] },
            "description": "List all clinics the doctor is assigned to."
          }
        },
        {
          "name": "Get Clinic by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clinics/{{clinicId}}", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "{{clinicId}}"] },
            "description": "Get basic clinic info by ID."
          }
        },
        {
          "name": "Get Clinic Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clinics/{{clinicId}}/profile", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "{{clinicId}}", "profile"] },
            "description": "Get detailed clinic profile including staff counts and schedule info."
          }
        },
        {
          "name": "Get Clinic Staff",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/clinics/{{clinicId}}/staff?staffRole=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clinics", "{{clinicId}}", "staff"],
              "query": [{ "key": "staffRole", "value": "", "description": "Filter by role: DOCTOR, SECRETARY" }]
            },
            "description": "List staff members at the clinic."
          }
        },
        {
          "name": "Get Clinic Doctors",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clinics/{{clinicId}}/doctors", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "{{clinicId}}", "doctors"] },
            "description": "List all doctors at the clinic."
          }
        }
      ]
    },
    {
      "name": "My Schedule",
      "item": [
        {
          "name": "Get My Available Slots",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/schedule/slots?clinicId={{clinicId}}&doctorId={{doctorId}}&date=2026-06-20&durationMinutes=30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schedule", "slots"],
              "query": [
                { "key": "clinicId", "value": "{{clinicId}}" },
                { "key": "doctorId", "value": "{{doctorId}}" },
                { "key": "date", "value": "2026-06-20", "description": "Format: YYYY-MM-DD" },
                { "key": "durationMinutes", "value": "30" }
              ]
            },
            "description": "Returns all available appointment time slots for the doctor at a clinic on a given date."
          }
        },
        {
          "name": "Get My Availability",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/schedule/availability?clinicId={{clinicId}}&doctorId={{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schedule", "availability"],
              "query": [
                { "key": "clinicId", "value": "{{clinicId}}" },
                { "key": "doctorId", "value": "{{doctorId}}" }
              ]
            },
            "description": "View own recurring weekly availability windows."
          }
        },
        {
          "name": "Get Clinic Hours",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/schedule/clinics/{{clinicId}}/hours", "host": ["{{baseUrl}}"], "path": ["api", "schedule", "clinics", "{{clinicId}}", "hours"] },
            "description": "Get the clinic's weekly operating hours."
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Get Appointment by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "{{appointmentId}}"] },
            "description": "Get a single appointment's full details enriched with clinic/doctor/patient info."
          }
        },
        {
          "name": "Update Appointment Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "{{appointmentId}}", "status"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\",\n  \"cancellationReason\": \"\"\n}"
            },
            "description": "Change appointment status. Values: PENDING | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW."
          }
        },
        {
          "name": "Update Appointment (add notes)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "{{appointmentId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Patient responded well to treatment. Follow-up in 2 weeks.\"\n}"
            },
            "description": "Add clinical notes or update appointment details."
          }
        }
      ]
    },
    {
      "name": "Doctor Public Profiles",
      "item": [
        {
          "name": "Get Doctor Public Profile by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/doctors/:id/public", "host": ["{{baseUrl}}"], "path": ["api", "users", "doctors", ":id", "public"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Get another doctor's public profile."
          }
        },
        {
          "name": "Get Multiple Doctors Public Profiles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users/doctors/public?ids=id1,id2,id3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "doctors", "public"],
              "query": [{ "key": "ids", "value": "id1,id2,id3", "description": "Comma-separated UUIDs, max 50" }]
            },
            "description": "Batch-fetch public doctor profiles by IDs."
          }
        }
      ]
    }
  ]
}
