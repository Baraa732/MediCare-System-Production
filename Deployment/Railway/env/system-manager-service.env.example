# system-manager-service — Railway env (placeholders only, no secrets)
NODE_ENV=production
# Set true only for the first deployment to a verified-empty database; then false permanently.
DB_BOOTSTRAP=false
PORT=3003

DATABASE_HOST=postgres-system.railway.internal
DATABASE_PORT=5432
DATABASE_USER=clinic_user
DATABASE_PASSWORD=REPLACE_db_password
DATABASE_NAME=system_db

# JWT (platform managers) — MUST differ from auth-service JWT_SECRET
JWT_SECRET=REPLACE_system_manager_jwt_secret
JWT_EXPIRES_IN=7d

INTERNAL_AUTH_SERVICE_NAME=system-manager-service
INTERNAL_AUTH_SECRET=REPLACE_sm_signing_secret_min_24_chars
INTERNAL_AUTH_TRUSTED_SECRETS={"api-gateway":"REPLACE_internal_auth_hmac_secret_min_24_chars","auth-service":"REPLACE_auth_signing_secret_min_24_chars","system-manager-service":"REPLACE_sm_signing_secret_min_24_chars"}

KAFKA_BROKERS=kafka-1.railway.internal:9092
KAFKA_RETRY_COUNT=12
KAFKA_CONNECTION_TIMEOUT=15000

CLINIC_SERVICE_URL=http://clinic-service.railway.internal:3006
EMR_SERVICE_URL=http://emr-service.railway.internal:3004
NOTIFICATION_SERVICE_URL=http://notification-service.railway.internal:3009
AUTH_SERVICE_URL=http://auth-service.railway.internal:3001
USER_SERVICE_URL=http://user-service.railway.internal:3002
API_GATEWAY_URL=http://api-gateway.railway.internal:3000

# Cross-DB stats (read clinic_db + user_db)
CLINIC_STATS_DATABASE_HOST=postgres-clinic.railway.internal
CLINIC_STATS_DATABASE_PORT=5432
CLINIC_STATS_DATABASE_USER=clinic_user
CLINIC_STATS_DATABASE_PASSWORD=REPLACE_db_password
CLINIC_STATS_DATABASE_NAME=clinic_db
USER_STATS_DATABASE_HOST=postgres-user.railway.internal
USER_STATS_DATABASE_PORT=5432
USER_STATS_DATABASE_USER=clinic_user
USER_STATS_DATABASE_PASSWORD=REPLACE_db_password
USER_STATS_DATABASE_NAME=user_db

# Persistent volume: mount Railway Volume at this path
ACTIVATION_DOCUMENTS_DIR=/usr/src/app/uploads/activation-documents

PROMETHEUS_URL=http://prometheus.railway.internal:9090
LOKI_URL=http://loki.railway.internal:3100
JAEGER_QUERY_URL=http://jaeger.railway.internal:16686
OTEL_COLLECTOR_URL=http://otel-collector.railway.internal:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.railway.internal:4318
OTEL_SERVICE_NAME=system-manager-service

# Default system manager bootstrap seed
DEFAULT_ADMIN_USERNAME=REPLACE_admin_username
DEFAULT_ADMIN_PASSWORD=REPLACE_admin_password
DEFAULT_ADMIN_FIRST_NAME=Admin
DEFAULT_ADMIN_LAST_NAME=User
DEFAULT_ADMIN_EMAIL=REPLACE_admin_email
DEFAULT_ADMIN_PHONE=REPLACE_admin_phone

ALLOWED_ORIGINS=https://REPLACE_gateway_domain,https://REPLACE_system_dashboard_domain
