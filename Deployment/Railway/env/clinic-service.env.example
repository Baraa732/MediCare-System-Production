# clinic-service — Railway env (placeholders only, no secrets)
NODE_ENV=production
# Set true only for the first deployment to a verified-empty database; then false permanently.
DB_BOOTSTRAP=false
PORT=3006

DATABASE_HOST=postgres-clinic.railway.internal
DATABASE_PORT=5432
DATABASE_USER=clinic_user
DATABASE_PASSWORD=REPLACE_db_password
DATABASE_NAME=clinic_db

JWT_SECRET=REPLACE_staff_patient_jwt_secret

INTERNAL_AUTH_SERVICE_NAME=clinic-service
INTERNAL_AUTH_SECRET=REPLACE_clinic_signing_secret_min_24_chars
INTERNAL_AUTH_TRUSTED_SECRETS={"api-gateway":"REPLACE_internal_auth_hmac_secret_min_24_chars","auth-service":"REPLACE_auth_signing_secret_min_24_chars","appointment-service":"REPLACE_appointment_signing_secret_min_24_chars","scheduling-service":"REPLACE_scheduling_signing_secret_min_24_chars","system-manager-service":"REPLACE_sm_signing_secret_min_24_chars"}

KAFKA_BROKERS=kafka-1.railway.internal:9092
KAFKA_RETRY_COUNT=12
KAFKA_CONNECTION_TIMEOUT=15000

USER_SERVICE_URL=http://user-service.railway.internal:3002
SCHEDULING_SERVICE_URL=http://scheduling-service.railway.internal:3008
APPOINTMENT_SERVICE_URL=http://appointment-service.railway.internal:3007

# Persistent volume: mount Railway Volume at this path
CLINIC_LOGO_UPLOAD_DIR=/usr/src/app/uploads/clinic-logos

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.railway.internal:4318
OTEL_SERVICE_NAME=clinic-service
LOKI_URL=http://loki.railway.internal:3100

ALLOWED_ORIGINS=https://REPLACE_gateway_domain,https://REPLACE_admin_dashboard_domain
