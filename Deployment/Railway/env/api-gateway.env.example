# api-gateway — Railway env (placeholders only, no secrets)
NODE_ENV=production
PORT=3000

# Internal service discovery (Railway private network)
AUTH_SERVICE_URL=http://auth-service.railway.internal:3001
USER_SERVICE_URL=http://user-service.railway.internal:3002
SYSTEM_MANAGER_SERVICE_URL=http://system-manager-service.railway.internal:3003
# Set EMR_SERVICE_URL only when emr-service is deployed (gateway /health/ready probes it when set)
# EMR_SERVICE_URL=http://emr-service.railway.internal:3004
CLINIC_SERVICE_URL=http://clinic-service.railway.internal:3006
APPOINTMENT_SERVICE_URL=http://appointment-service.railway.internal:3007
SCHEDULING_SERVICE_URL=http://scheduling-service.railway.internal:3008
NOTIFICATION_SERVICE_URL=http://notification-service.railway.internal:3009

# Optional JSON route map (overrides the *_SERVICE_URL fallbacks)
GATEWAY_ROUTES=

# CORS: public dashboard domains (required when dashboards call gateway directly)
ALLOWED_ORIGINS=https://REPLACE_admin_dashboard_domain,https://REPLACE_system_dashboard_domain

# Security — INTERNAL_AUTH_* are mandatory (requireInternalAuthConfig)
JWT_SECRET=REPLACE_staff_patient_jwt_secret
CSRF_SECRET=REPLACE_csrf_secret
INTERNAL_SERVICE_TOKEN=REPLACE_internal_service_token
INTERNAL_AUTH_SERVICE_NAME=api-gateway
INTERNAL_AUTH_SECRET=REPLACE_internal_auth_hmac_secret_min_24_chars
INTERNAL_AUTH_TRUSTED_SECRETS={"auth-service":"REPLACE_auth_signing_secret_min_24_chars","api-gateway":"REPLACE_internal_auth_hmac_secret_min_24_chars"}

# Redis JWT cache (optional; gateway starts if Redis is down)
REDIS_HOST=redis.railway.internal
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_redis_password
JWT_CACHE_ENABLED=true
JWT_CACHE_TTL=300

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
