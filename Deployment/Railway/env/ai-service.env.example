# ai-service (OPTIONAL) — Railway env (placeholders only, no secrets)
NODE_ENV=production
# Set true only for the first deployment to a verified-empty database; then false permanently.
DB_BOOTSTRAP=false
PORT=3005

DATABASE_HOST=postgres-ai.railway.internal
DATABASE_PORT=5432
DATABASE_USER=clinic_user
DATABASE_PASSWORD=REPLACE_db_password
DATABASE_NAME=ai_db

REDIS_URL=redis://:REPLACE_redis_password@redis.railway.internal:6379

JWT_SECRET=REPLACE_staff_patient_jwt_secret
INTERNAL_SERVICE_TOKEN=REPLACE_internal_service_token_min_24_chars

CLINIC_SERVICE_URL=http://clinic-service.railway.internal:3006
USER_SERVICE_URL=http://user-service.railway.internal:3002
SCHEDULING_SERVICE_URL=http://scheduling-service.railway.internal:3008
APPOINTMENT_SERVICE_URL=http://appointment-service.railway.internal:3007

AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=60000

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.railway.internal:4318
OTEL_SERVICE_NAME=ai-service

ALLOWED_ORIGINS=https://REPLACE_gateway_domain
