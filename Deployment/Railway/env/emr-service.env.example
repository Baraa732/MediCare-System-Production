# emr-service (OPTIONAL) — Railway env (placeholders only, no secrets)
NODE_ENV=production
# Set true only for the first deployment to a verified-empty database; then false permanently.
DB_BOOTSTRAP=false
PORT=3004

DATABASE_HOST=postgres-emr.railway.internal
DATABASE_PORT=5432
DATABASE_USER=clinic_user
DATABASE_PASSWORD=REPLACE_db_password
DATABASE_NAME=emr_db

JWT_SECRET=REPLACE_staff_patient_jwt_secret
INTERNAL_SERVICE_TOKEN=REPLACE_internal_service_token_min_24_chars

INTERNAL_AUTH_SERVICE_NAME=emr-service
INTERNAL_AUTH_SECRET=REPLACE_emr_signing_secret_min_24_chars
INTERNAL_AUTH_TRUSTED_SECRETS={"api-gateway":"REPLACE_internal_auth_hmac_secret_min_24_chars","auth-service":"REPLACE_auth_signing_secret_min_24_chars","appointment-service":"REPLACE_appointment_signing_secret_min_24_chars"}

KAFKA_BROKERS=kafka-1.railway.internal:9092

OPENEMR_BASE_URL=http://openemr.railway.internal
OPENEMR_SITE=default
OPENEMR_ADMIN_USER=admin
OPENEMR_ADMIN_PASSWORD=REPLACE_openemr_admin_password
OPENEMR_CLIENT_ID=REPLACE_openemr_client_id
OPENEMR_CLIENT_SECRET=REPLACE_openemr_client_secret
OPENEMR_MYSQL_HOST=mariadb-openemr.railway.internal
OPENEMR_MYSQL_USER=openemr
OPENEMR_MYSQL_PASSWORD=REPLACE_openemr_mysql_password
OPENEMR_MYSQL_DATABASE=openemr

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.railway.internal:4318
OTEL_SERVICE_NAME=emr-service
LOKI_URL=http://loki.railway.internal:3100

ALLOWED_ORIGINS=https://REPLACE_gateway_domain
