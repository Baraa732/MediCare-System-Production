# clinic-admin-dashboard — build args + runtime
# VITE_API_BASE_URL is a BUILD-TIME arg (baked into the SPA).
# Must be the public HTTPS URL of api-gateway (no trailing slash required by client).
# Example production (reliable-flow / anasdalati3):
# https://medicare-system-production-production-8ce0.up.railway.app
VITE_API_BASE_URL=https://medicare-system-production-production-8ce0.up.railway.app

# Runtime (nginx listens on 80). Point Railway to container port 80, or set PORT=80.
PORT=80
