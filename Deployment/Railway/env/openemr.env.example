# openemr — Railway env (placeholders only, no secrets)
MYSQL_HOST=mariadb-openemr.railway.internal
MYSQL_ROOT_PASS=REPLACE_openemr_mysql_root_password
MYSQL_USER=openemr
MYSQL_PASS=REPLACE_openemr_mysql_password
MYSQL_DATABASE=openemr

OE_USER=REPLACE_openemr_admin_username
OE_PASS=REPLACE_openemr_admin_password

OPENEMR_SETTING_rest_api=1
OPENEMR_SETTING_rest_fhir_api=1
OPENEMR_SETTING_rest_portal_api=1
OPENEMR_SETTING_oauth_password_grant=3
OPENEMR_SETTING_site_addr_oath=https://openemr
OPENEMR_SETTING_oauth_app_manual_approval=0
