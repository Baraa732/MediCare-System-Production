# scheduling-service — Railway env (placeholders only, no secrets)
NODE_ENV=production
# Set true only for the first deployment to a verified-empty database; then false permanently.
DB_BOOTSTRAP=false
PORT=3008

DATABASE_HOST=postgres-scheduling.railway.internal
DATABASE_PORT=5432
DATABASE_USER=clinic_user
DATABASE_PASSWORD=REPLACE_db_password
DATABASE_NAME=scheduling_db

JWT_SECRET=REPLACE_staff_patient_jwt_secret

INTERNAL_AUTH_SERVICE_NAME=scheduling-service
INTERNAL_AUTH_SECRET=REPLACE_scheduling_signing_secret_min_24_chars
INTERNAL_AUTH_TRUSTED_SECRETS={"api-gateway":"REPLACE_internal_auth_hmac_secret_min_24_chars","clinic-service":"REPLACE_clinic_signing_secret_min_24_chars","appointment-service":"REPLACE_appointment_signing_secret_min_24_chars"}

KAFKA_BROKERS=kafka-1.railway.internal:9092

CLINIC_SERVICE_URL=http://clinic-service.railway.internal:3006
APPOINTMENT_SERVICE_URL=http://appointment-service.railway.internal:3007

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.railway.internal:4318
OTEL_SERVICE_NAME=scheduling-service

ALLOWED_ORIGINS=https://REPLACE_gateway_domain,https://REPLACE_admin_dashboard_domain
