# auth-service — Railway env (placeholders only, no secrets)
NODE_ENV=production
# Set true only for the first deployment to a verified-empty database; then false permanently.
DB_BOOTSTRAP=false
PORT=3001

DATABASE_HOST=postgres-auth.railway.internal
DATABASE_PORT=5432
DATABASE_USER=clinic_user
DATABASE_PASSWORD=REPLACE_db_password
DATABASE_NAME=auth_db

# JWT (staff/patient) — MUST differ from system-manager-service JWT_SECRET
JWT_SECRET=REPLACE_staff_patient_jwt_secret
JWT_EXPIRES_IN=15m

INTERNAL_SERVICE_TOKEN=REPLACE_internal_service_token
INTERNAL_AUTH_SERVICE_NAME=auth-service
INTERNAL_AUTH_SECRET=REPLACE_auth_signing_secret_min_24_chars
INTERNAL_AUTH_TRUSTED_SECRETS={"api-gateway":"REPLACE_internal_auth_hmac_secret_min_24_chars","auth-service":"REPLACE_auth_signing_secret_min_24_chars","system-manager-service":"REPLACE_sm_signing_secret_min_24_chars"}

KAFKA_BROKERS=kafka-1.railway.internal:9092

REDIS_URL=redis://:REPLACE_redis_password@redis.railway.internal:6379

USER_SERVICE_URL=http://user-service.railway.internal:3002
CLINIC_SERVICE_URL=http://clinic-service.railway.internal:3006
SYSTEM_MANAGER_SERVICE_URL=http://system-manager-service.railway.internal:3003
API_GATEWAY_URL=http://api-gateway.railway.internal:3000

# WhatsApp (Evolution) — optional for first deploy
EVOLUTION_API_URL=http://evolution-api.railway.internal:8080
EVOLUTION_API_KEY=REPLACE_evolution_api_key
WHATSAPP_INSTANCE_NAME=clinic-management
WHATSAPP_PROFILE_NAME=MediCare

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.railway.internal:4318
OTEL_SERVICE_NAME=auth-service

ALLOWED_ORIGINS=https://REPLACE_gateway_domain,https://REPLACE_admin_dashboard_domain
