# appointment-service — Railway env (placeholders only, no secrets)
NODE_ENV=production
# Set true only for the first deployment to a verified-empty database; then false permanently.
DB_BOOTSTRAP=false
PORT=3007

DATABASE_HOST=postgres-appointment.railway.internal
DATABASE_PORT=5432
DATABASE_USER=clinic_user
DATABASE_PASSWORD=REPLACE_db_password
DATABASE_NAME=appointment_db

JWT_SECRET=REPLACE_staff_patient_jwt_secret

INTERNAL_AUTH_SERVICE_NAME=appointment-service
INTERNAL_AUTH_SECRET=REPLACE_appointment_signing_secret_min_24_chars
INTERNAL_AUTH_TRUSTED_SECRETS={"api-gateway":"REPLACE_internal_auth_hmac_secret_min_24_chars","clinic-service":"REPLACE_clinic_signing_secret_min_24_chars","scheduling-service":"REPLACE_scheduling_signing_secret_min_24_chars"}

KAFKA_BROKERS=kafka-1.railway.internal:9092
KAFKA_RETRY_COUNT=12
KAFKA_CONNECTION_TIMEOUT=15000

USER_SERVICE_URL=http://user-service.railway.internal:3002
CLINIC_SERVICE_URL=http://clinic-service.railway.internal:3006
SCHEDULING_SERVICE_URL=http://scheduling-service.railway.internal:3008

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.railway.internal:4318
OTEL_SERVICE_NAME=appointment-service

ALLOWED_ORIGINS=https://REPLACE_gateway_domain,https://REPLACE_admin_dashboard_domain
