# system-manager-dashboard — build args + runtime
# VITE_* are BUILD-TIME args (baked into the SPA).
# VITE_API_BASE_URL must be the public HTTPS URL of api-gateway.
VITE_API_BASE_URL=https://medicare-system-production-production-8ce0.up.railway.app
VITE_GRAFANA_URL=https://grafana-production-8f8d.up.railway.app
VITE_GRAFANA_DASHBOARD_UID=medicare-platform

# Runtime (nginx listens on 80). Point Railway to container port 80, or set PORT=80.
PORT=80
