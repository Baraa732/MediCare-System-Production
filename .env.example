# ============================================================
# docker-compose shared infrastructure secrets — EXAMPLE
# Copy to .env and fill in real values. Never commit .env
# ============================================================

POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=

REDIS_PASSWORD=

MONGO_USER=mongo_admin
MONGO_PASSWORD=

EVOLUTION_API_KEY=

# OpenEMR (EHR) — MariaDB + admin login for https://localhost:8081
OPENEMR_MYSQL_ROOT_PASSWORD=
OPENEMR_MYSQL_USER=openemr
OPENEMR_MYSQL_PASSWORD=
OPENEMR_ADMIN_USER=admin
OPENEMR_ADMIN_PASSWORD=

# Deployment profile — dev (local), staging, production
# Local stack:  docker compose up -d   (requires docker-compose.override.yml for DB/UI ports)
# Staging:       docker compose -f docker-compose.yml -f docker-compose.staging.yml up -d
# Production:    docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
MEDICARE_ENV=development
MEDICARE_DEPLOY_PROFILE=dev
API_GATEWAY_HOST_PORT=3000

# Kafka event signing (zero-trust envelope)
KAFKA_EVENT_SIGNING_REQUIRED=false
KAFKA_EVENT_SIGNING_SECRET=
KAFKA_EVENT_TRUSTED_SECRETS={}
KAFKA_EVENT_REPLAY_WINDOW_MS=300000

# Kafka transport security (production: SASL_SSL)
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Kafka — comma-separated list of all broker addresses
# docker-compose injects this into every service automatically
KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
