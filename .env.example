# ============================================================
# docker-compose shared infrastructure secrets — EXAMPLE
# Copy to .env and fill in real values. Never commit .env
# ============================================================

POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=

REDIS_PASSWORD=

MONGO_USER=mongo_admin
MONGO_PASSWORD=

EVOLUTION_API_KEY=

# OpenEMR (EHR) — MariaDB + admin login for https://localhost:8081
OPENEMR_MYSQL_ROOT_PASSWORD=
OPENEMR_MYSQL_USER=openemr
OPENEMR_MYSQL_PASSWORD=
OPENEMR_ADMIN_USER=admin
OPENEMR_ADMIN_PASSWORD=

# Kafka — comma-separated list of all broker addresses
# docker-compose injects this into every service automatically
KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
