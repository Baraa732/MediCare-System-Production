{
  "title": "MediCare — Auth Service",
  "uid": "medicare-auth",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Login Success Rate",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "rate(http_requests_total{job='auth-service',path='/auth/login',status='200'}[5m])",
        "legendFormat": "logins/sec"
      }]
    },
    {
      "id": 2,
      "title": "Login Failures / min",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "rate(http_requests_total{job='auth-service',path='/auth/login',status=~'4..'}[1m]) * 60",
        "legendFormat": "failures/min"
      }]
    },
    {
      "id": 3,
      "title": "OTP Sends / min",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "rate(http_requests_total{job='auth-service',path=~'/auth/send-otp|/auth/resend-otp'}[1m]) * 60",
        "legendFormat": "otp/min"
      }]
    },
    {
      "id": 4,
      "title": "Token Refreshes / min",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "rate(http_requests_total{job='auth-service',path='/auth/refresh-token',status='200'}[1m]) * 60",
        "legendFormat": "refreshes/min"
      }]
    },
    {
      "id": 5,
      "title": "p95 Login Latency (ms)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(http_request_duration_ms_bucket{job='auth-service',path='/auth/login'}[5m]))",
        "legendFormat": "p95 ms"
      }]
    },
    {
      "id": 6,
      "title": "p99 Login Latency (ms)",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(http_request_duration_ms_bucket{job='auth-service',path='/auth/login'}[5m]))",
        "legendFormat": "p99 ms"
      }]
    },
    {
      "id": 7,
      "title": "Request Rate by Endpoint",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(http_requests_total{job='auth-service'}[1m])",
        "legendFormat": "{{path}} {{status}}"
      }]
    },
    {
      "id": 8,
      "title": "DB Connection Pool Usage",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname='auth_db'}",
          "legendFormat": "active connections"
        },
        {
          "expr": "20",
          "legendFormat": "pool max (20)"
        }
      ]
    },
    {
      "id": 9,
      "title": "Redis Memory Usage",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 6 },
      "targets": [{
        "expr": "redis_memory_used_bytes",
        "legendFormat": "used bytes"
      }]
    },
    {
      "id": 10,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 12, "w": 16, "h": 6 },
      "targets": [{
        "expr": "kafka_consumer_group_lag",
        "legendFormat": "{{topic}} {{partition}}"
      }]
    }
  ]
}
