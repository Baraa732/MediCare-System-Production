{
  "info": {
    "name": "MediCare – System Manager Endpoints",
    "_postman_id": "sysmgr-collection-001",
    "description": "All API endpoints available to a SYSTEM_MANAGER role in the MediCare clinic management system. System managers have the highest privilege level — they can manage all users, clinics, activation codes, and view all data across the platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "clinicId", "value": "", "type": "string" },
    { "key": "doctorId", "value": "", "type": "string" },
    { "key": "patientId", "value": "", "type": "string" },
    { "key": "appointmentId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "activationCode", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "System Manager Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/system-manager/login", "host": ["{{baseUrl}}"], "path": ["api", "system-manager", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"AdminPass123!\"\n}"
            },
            "description": "Authenticate as a system manager. Returns JWT access and refresh tokens."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh-token"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"your-refresh-token-here\"\n}"
            },
            "description": "Exchange a refresh token for a new access + refresh token pair."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"optional-session-id\"\n}"
            },
            "description": "Logout the current session."
          }
        },
        {
          "name": "Get Active Sessions",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/sessions", "host": ["{{baseUrl}}"], "path": ["api", "auth", "sessions"] },
            "description": "List all active sessions for the currently authenticated system manager."
          }
        },
        {
          "name": "Revoke Session by ID",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/auth/sessions/:sessionId", "host": ["{{baseUrl}}"], "path": ["api", "auth", "sessions", ":sessionId"], "variable": [{ "key": "sessionId", "value": "" }] },
            "description": "Revoke a specific session by its ID."
          }
        },
        {
          "name": "Revoke All Sessions",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/auth/sessions?except=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sessions"],
              "query": [{ "key": "except", "value": "", "description": "Session ID to keep alive (optional)" }]
            },
            "description": "Revoke all sessions, optionally keeping the current one."
          }
        },
        {
          "name": "Create System Manager Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/system-manager/create", "host": ["{{baseUrl}}"], "path": ["api", "system-manager", "create"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"manager2\",\n  \"password\": \"Manager123!\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Smith\",\n  \"email\": \"manager2@system.com\"\n}"
            },
            "description": "Create another system manager account. Requires SYSTEM_MANAGER auth."
          }
        }
      ]
    },
    {
      "name": "Clinic Admin Management",
      "item": [
        {
          "name": "Create Clinic Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/system-manager/create-clinic-admin", "host": ["{{baseUrl}}"], "path": ["api", "system-manager", "create-clinic-admin"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+9647XXXXXXXXX\",\n  \"firstName\": \"Dr. Omar\",\n  \"lastName\": \"Al-Rashid\",\n  \"email\": \"clinic.admin@hospital.com\",\n  \"clinicName\": \"Al-Rashid Medical Center\"\n}"
            },
            "description": "Create a clinic admin account and trigger the activation code flow."
          }
        }
      ]
    },
    {
      "name": "Activation Codes",
      "item": [
        {
          "name": "Generate Activation Code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/system-manager/activation-code/generate", "host": ["{{baseUrl}}"], "path": ["api", "system-manager", "activation-code", "generate"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idNumber\": \"1234567890\",\n  \"phoneNumber\": \"+9647XXXXXXXXX\",\n  \"fullName\": \"Omar Al-Rashid\",\n  \"clinicLocation\": \"Baghdad, Al-Karrada\",\n  \"price\": 500000,\n  \"isCashPaymentDone\": true,\n  \"notes\": \"Paid in full. Contract signed.\"\n}"
            },
            "description": "Generate an 8-character activation code for a future clinic admin. Encodes payment and identity info."
          }
        },
        {
          "name": "Get Activation Code Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/system-manager/activation-code/status?code={{activationCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "system-manager", "activation-code", "status"],
              "query": [{ "key": "code", "value": "{{activationCode}}", "description": "8-character activation code" }]
            },
            "description": "Get the current status of an activation code (used, active, revoked, etc.)."
          }
        },
        {
          "name": "Revoke Activation Code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/system-manager/activation-code/revoke", "host": ["{{baseUrl}}"], "path": ["api", "system-manager", "activation-code", "revoke"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{activationCode}}\",\n  \"reason\": \"Payment reversed\"\n}"
            },
            "description": "Revoke an activation code so it can no longer be used."
          }
        }
      ]
    },
    {
      "name": "User Management",
      "item": [
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                { "key": "page", "value": "1", "description": "Default 1" },
                { "key": "limit", "value": "20", "description": "Default 20, max 100" }
              ]
            },
            "description": "List all users in the system with pagination. SYSTEM_MANAGER only."
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+9647XXXXXXXXX\",\n  \"firstName\": \"New\",\n  \"lastName\": \"User\",\n  \"password\": \"TempPass123!\",\n  \"role\": \"PATIENT\",\n  \"email\": \"user@email.com\",\n  \"clinicId\": \"{{clinicId}}\"\n}"
            },
            "description": "Create a new user account."
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "description": "Get full user profile by ID."
          }
        },
        {
          "name": "Get User by Phone",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/phone/:phoneNumber", "host": ["{{baseUrl}}"], "path": ["api", "users", "phone", ":phoneNumber"], "variable": [{ "key": "phoneNumber", "value": "+9647XXXXXXXXX" }] },
            "description": "Look up a user by exact phone number."
          }
        },
        {
          "name": "Lookup Patient by Phone",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/lookup/patient/:phoneNumber", "host": ["{{baseUrl}}"], "path": ["api", "users", "lookup", "patient", ":phoneNumber"], "variable": [{ "key": "phoneNumber", "value": "+9647XXXXXXXXX" }] },
            "description": "Look up a patient account by phone number."
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Name\",\n  \"email\": \"updated@email.com\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "description": "Update user profile fields."
          }
        },
        {
          "name": "Change User Status",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}", "status"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SUSPENDED\"\n}"
            },
            "description": "Change a user's account status. Values: ACTIVE | SUSPENDED | etc."
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "description": "Permanently delete a user account. SYSTEM_MANAGER only."
          }
        }
      ]
    },
    {
      "name": "Clinic Management",
      "item": [
        {
          "name": "Create Clinic",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/clinics", "host": ["{{baseUrl}}"], "path": ["api", "clinics"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Medical Clinic\",\n  \"description\": \"General practice clinic\",\n  \"address\": \"123 Main St\",\n  \"city\": \"Baghdad\",\n  \"governorate\": \"Baghdad\",\n  \"phone\": \"+9641XXXXXXXXX\",\n  \"email\": \"clinic@email.com\",\n  \"timezone\": \"Asia/Baghdad\"\n}"
            },
            "description": "Manually create a new clinic."
          }
        },
        {
          "name": "List All Clinics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/clinics?status=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clinics"],
              "query": [{ "key": "status", "value": "", "description": "ClinicStatus filter (optional)" }]
            },
            "description": "List all clinics in the system. System manager sees all clinics."
          }
        },
        {
          "name": "Search Clinics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/clinics/search?q=&city=&governorate=&specialization=&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clinics", "search"],
              "query": [
                { "key": "q", "value": "" },
                { "key": "city", "value": "" },
                { "key": "governorate", "value": "" },
                { "key": "specialization", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Full-text and filtered search for clinics."
          }
        },
        {
          "name": "Get Clinic by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clinics/{{clinicId}}", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "{{clinicId}}"] },
            "description": "Get basic clinic info by ID."
          }
        },
        {
          "name": "Get Clinic Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clinics/{{clinicId}}/profile", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "{{clinicId}}", "profile"] },
            "description": "Get detailed clinic profile."
          }
        },
        {
          "name": "Update Clinic",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/clinics/{{clinicId}}", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "{{clinicId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Clinic Name\",\n  \"status\": \"ACTIVE\",\n  \"city\": \"Baghdad\",\n  \"phone\": \"+9641XXXXXXXXX\"\n}"
            },
            "description": "Update clinic details."
          }
        },
        {
          "name": "Delete Clinic",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/clinics/{{clinicId}}", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "{{clinicId}}"] },
            "description": "Delete a clinic."
          }
        },
        {
          "name": "Get Clinic Staff",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/clinics/{{clinicId}}/staff?staffRole=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clinics", "{{clinicId}}", "staff"],
              "query": [{ "key": "staffRole", "value": "", "description": "Filter: DOCTOR, SECRETARY" }]
            },
            "description": "List staff members assigned to a clinic."
          }
        },
        {
          "name": "Assign Staff to Clinic",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/clinics/{{clinicId}}/staff", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "{{clinicId}}", "staff"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"staffRole\": \"DOCTOR\"\n}"
            },
            "description": "Assign a user to a clinic as staff. staffRole: DOCTOR | SECRETARY."
          }
        },
        {
          "name": "Remove Staff from Clinic",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/clinics/{{clinicId}}/staff/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "{{clinicId}}", "staff", "{{userId}}"] },
            "description": "Remove a staff member from a clinic."
          }
        },
        {
          "name": "Get Clinics for User",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clinics/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "clinics", "users", "{{userId}}"] },
            "description": "List all clinics a specific user is assigned to."
          }
        }
      ]
    },
    {
      "name": "Schedule Management",
      "item": [
        {
          "name": "Get Available Slots",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/schedule/slots?clinicId={{clinicId}}&doctorId={{doctorId}}&date=2026-06-20&durationMinutes=30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schedule", "slots"],
              "query": [
                { "key": "clinicId", "value": "{{clinicId}}" },
                { "key": "doctorId", "value": "{{doctorId}}" },
                { "key": "date", "value": "2026-06-20" },
                { "key": "durationMinutes", "value": "30" }
              ]
            },
            "description": "Returns all available appointment time slots for a doctor at a clinic."
          }
        },
        {
          "name": "Get Doctor Availability",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/schedule/availability?clinicId={{clinicId}}&doctorId={{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schedule", "availability"],
              "query": [
                { "key": "clinicId", "value": "{{clinicId}}" },
                { "key": "doctorId", "value": "{{doctorId}}", "description": "Optional" }
              ]
            },
            "description": "List doctor availability windows (recurring weekly schedule)."
          }
        },
        {
          "name": "Create Availability Window",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/schedule/availability", "host": ["{{baseUrl}}"], "path": ["api", "schedule", "availability"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicId\": \"{{clinicId}}\",\n  \"doctorId\": \"{{doctorId}}\",\n  \"dayOfWeek\": 1,\n  \"startTime\": \"09:00\",\n  \"endTime\": \"13:00\",\n  \"slotDurationMinutes\": 30\n}"
            },
            "description": "Create a recurring availability window for a doctor. dayOfWeek: 0=Sunday … 6=Saturday."
          }
        },
        {
          "name": "Block Time Period",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/schedule/blocked", "host": ["{{baseUrl}}"], "path": ["api", "schedule", "blocked"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicId\": \"{{clinicId}}\",\n  \"doctorId\": \"{{doctorId}}\",\n  \"startsAt\": \"2026-06-25T08:00:00.000Z\",\n  \"endsAt\": \"2026-06-25T12:00:00.000Z\",\n  \"reason\": \"Public holiday\"\n}"
            },
            "description": "Block out a time period for a doctor or the entire clinic."
          }
        },
        {
          "name": "Get Clinic Hours",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/schedule/clinics/{{clinicId}}/hours", "host": ["{{baseUrl}}"], "path": ["api", "schedule", "clinics", "{{clinicId}}", "hours"] },
            "description": "Get the clinic's weekly operating hours."
          }
        },
        {
          "name": "Update Clinic Hours",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/schedule/clinics/{{clinicId}}/hours", "host": ["{{baseUrl}}"], "path": ["api", "schedule", "clinics", "{{clinicId}}", "hours"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayOfWeek\": 5,\n  \"openTime\": \"09:00\",\n  \"closeTime\": \"14:00\",\n  \"isClosed\": false\n}"
            },
            "description": "Set or update a clinic's hours for a specific day."
          }
        }
      ]
    },
    {
      "name": "Appointment Management",
      "item": [
        {
          "name": "List All Clinic Appointments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/appointments?clinicId={{clinicId}}&doctorId=&patientId=&status=&from=&to=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments"],
              "query": [
                { "key": "clinicId", "value": "{{clinicId}}", "description": "Required" },
                { "key": "doctorId", "value": "" },
                { "key": "patientId", "value": "" },
                { "key": "status", "value": "", "description": "PENDING | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW" },
                { "key": "from", "value": "" },
                { "key": "to", "value": "" }
              ]
            },
            "description": "List clinic appointments with filtering."
          }
        },
        {
          "name": "Get Appointment by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "{{appointmentId}}"] },
            "description": "Get full appointment details enriched with clinic/doctor/patient info."
          }
        },
        {
          "name": "Create Appointment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/appointments", "host": ["{{baseUrl}}"], "path": ["api", "appointments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinicId\": \"{{clinicId}}\",\n  \"doctorId\": \"{{doctorId}}\",\n  \"patientId\": \"{{patientId}}\",\n  \"scheduledAt\": \"2026-06-20T10:00:00.000Z\",\n  \"durationMinutes\": 30,\n  \"reason\": \"Administrative booking\"\n}"
            },
            "description": "Create an appointment on behalf of any patient."
          }
        },
        {
          "name": "Update Appointment",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "{{appointmentId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduledAt\": \"2026-06-21T11:00:00.000Z\",\n  \"notes\": \"Rescheduled by system manager\"\n}"
            },
            "description": "Update appointment details."
          }
        },
        {
          "name": "Update Appointment Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "{{appointmentId}}", "status"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\",\n  \"cancellationReason\": \"\"\n}"
            },
            "description": "Change appointment status. Values: PENDING | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW."
          }
        }
      ]
    },
    {
      "name": "Account Linking",
      "item": [
        {
          "name": "Link Patient Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/account-linking/link-patient", "host": ["{{baseUrl}}"], "path": ["api", "account-linking", "link-patient"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+9647XXXXXXXXX\",\n  \"firstName\": \"Patient\",\n  \"lastName\": \"Name\",\n  \"email\": \"patient@email.com\"\n}"
            },
            "description": "Link a new/existing patient account to this system manager."
          }
        },
        {
