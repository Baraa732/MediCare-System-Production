  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "migration:run": "node ./node_modules/typeorm/cli.js migration:run -d dist/typeorm-data-source.js",
