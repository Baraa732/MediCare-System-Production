# ============================================================
# auth-service environment — EXAMPLE. Copy to .env
# ============================================================
NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://clinic_user:CHANGE_ME@postgres-auth:5432/auth_db
DATABASE_HOST=postgres-auth
DATABASE_PORT=5432
DATABASE_USER=clinic_user
DATABASE_PASSWORD=
DATABASE_NAME=auth_db

# MUST differ from system-manager-service JWT_SECRET (staff/patient tokens only)
JWT_SECRET=
JWT_EXPIRES_IN=15m

INTERNAL_SERVICE_TOKEN=

KAFKA_BROKERS=kafka-1:9092

REDIS_URL=redis://:CHANGE_ME@redis:6379

EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
WHATSAPP_INSTANCE_NAME=clinic-management
WHATSAPP_PROFILE_NAME=MediCare

ALLOWED_ORIGINS=http://localhost:3000
