{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Authentication service for clinic management system",
  "main": "dist/main.js",
  "scripts": {
    "sync:whatsapp": "node -e \"const fs=require('fs');const p=require('path');const r=p.resolve(__dirname,'../../../../Integrations/WhatsApp/client/whatsapp.service.ts');const d=p.resolve(__dirname,'src/auth/services/whatsapp.service.ts');const h='// Synced from Integrations/WhatsApp/client/whatsapp.service.ts — edit source there, then: npm run sync:whatsapp\\n\\n';fs.writeFileSync(d,h+fs.readFileSync(r,'utf8'));\"",
    "prebuild": "npm run sync:whatsapp",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "migration:run": "node ./node_modules/typeorm/cli.js migration:run -d dist/typeorm-data-source.js",
    "migration:run:dev": "typeorm-ts-node-commonjs migration:run -d src/typeorm-data-source.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "keywords": [
    "nestjs",
    "authentication",
    "whatsapp",
    "otp",
    "microservice"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@medicare/telemetry": "file:../../libs/telemetry",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/typeorm": "^11.0.1",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.3.2",
    "kafkajs": "^2.2.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "typeorm": "^0.3.29",
    "prom-client": "^15.1.3",
    "@willsoto/nestjs-prometheus": "^6.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.7.0",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3"
  }
}
