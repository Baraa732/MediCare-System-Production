# API Gateway Configuration
PORT=3000
NODE_ENV=development

# Service URLs (used as fallback when GATEWAY_ROUTES is not set)
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
SYSTEM_MANAGER_SERVICE_URL=http://localhost:3003
EMR_SERVICE_URL=http://localhost:3004

# Dynamic route config — set this to avoid code changes when adding services.
# JSON array of {prefix, target} objects. Falls back to SERVICE_URLS above if unset.
# GATEWAY_ROUTES='[{"prefix":"/api/auth","target":"http://auth-service:3001"},{"prefix":"/api/users","target":"http://user-service:3002"},{"prefix":"/api/account-linking","target":"http://user-service:3002"},{"prefix":"/api/system-manager","target":"http://system-manager-service:3003"},{"prefix":"/api/emr","target":"http://emr-service:3004"}]'
GATEWAY_ROUTES=

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:5173,http://localhost:5174

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CSRF_SECRET=your-csrf-secret-key-change-in-production
INTERNAL_SERVICE_TOKEN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json